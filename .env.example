# ---------------------------------------------------------------------------
# GenOra Marketplace — environment variables (copy to .env; never commit .env)
# ---------------------------------------------------------------------------

# --- Application ------------------------------------------------------------
APP_ENV=development                 # development | test | production
LOG_LEVEL=INFO
LOG_JSON=true
CORS_ORIGINS=http://localhost:3000
PUBLIC_BASE_URL=http://localhost:3000

# --- Database (Postgres 16 + pgvector) ----------------------------------------
POSTGRES_USER=genora
POSTGRES_PASSWORD=change-me
POSTGRES_DB=genora
POSTGRES_PORT=5433
DATABASE_URL=postgresql+psycopg://genora:change-me@localhost:5433/genora

# --- Auth -----------------------------------------------------------------------
# REQUIRED in production: at least 32 random characters (e.g. `openssl rand -hex 32`)
JWT_SECRET=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=14
REFRESH_COOKIE_SECURE=false          # true behind HTTPS

# --- Commerce -------------------------------------------------------------------
TAX_RATE=0.08
SHIPPING_FLAT_RATE=5.99
FREE_SHIPPING_THRESHOLD=75.00
PAYMENT_PROVIDER=sandbox             # sandbox | stripe
STRIPE_API_KEY=                      # required when PAYMENT_PROVIDER=stripe

# --- Storage --------------------------------------------------------------------
STORAGE_PROVIDER=local
MEDIA_ROOT=media
MAX_UPLOAD_MB=8

# --- AI (OpenAI-compatible; leave LLM_PROVIDER=none for rule-based mode) --------
LLM_PROVIDER=none                    # none | openai_compatible
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TEMPERATURE=0.2
EMBEDDING_PROVIDER=hashing           # hashing | fastembed | openai_compatible
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=384             # fixed by the database migration
VISION_PROVIDER=none                 # none | openai_compatible
VISION_MODEL_NAME=gpt-4o-mini

# External price comparison: comma-separated provider names (static_feed, mock_a, mock_b).
# mock_* providers return clearly-labelled TEST DATA and must not be used in production.
EXTERNAL_PRICE_PROVIDERS=
EXTERNAL_PRICE_FEED_PATH=

# --- Forecasting ----------------------------------------------------------------
FORECAST_DEFAULT_PROVIDER=baseline   # baseline | seasonal_naive | timesfm (if installed)
FORECAST_MAX_HORIZON_DAYS=90

# --- Bootstrapping (docker) ----------------------------------------------------
RUN_MIGRATIONS=false
SEED_ON_START=false

# --- Frontend -------------------------------------------------------------------
BACKEND_URL=http://localhost:8000
